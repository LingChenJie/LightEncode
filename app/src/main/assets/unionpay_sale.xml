<?xml version="1.0" encoding="utf-8"?>
<!--
    银联 POS 消费报文（0200 请求 / 0210 响应）字段配置示例。

    报文结构：
        [2-byte Length] [5-byte TPDU/Header] [MTI] [Bitmap] [Data Elements]

    重要说明：
    1. 本文件只定义 MTI 和数据域的编码规则，不定义 Length、TPDU/Header 或 Bitmap。
       Length/Header 由调用方传入，Bitmap 由 ios8583encode 根据实际字段自动生成。
    2. position=0 表示 MTI；position=1 是 Bitmap 保留位，不应配置。
    3. lengthType 使用库兼容值：NONE=定长、PAIR=LLVAR、TRIP=LLLVAR。
    4. lengthEncode 表示变长域长度头的编码，本示例采用 BCD；定长域保留该属性但不使用。
    5. dataEncode：BCD=压缩数字/十六进制半字节，ASC=US-ASCII，BIT=原始二进制。
    6. dataLength：BCD 按半字节字符数计；ASC/BIT 按字节数计。变长域填写规范最大长度，
       组包时会根据实际值重新生成 LLVAR/LLLVAR 长度。
    7. 奇数位 BCD 数值域使用 RIGHT + padding="0"，即高半字节补 0；其余字段左对齐。
    8. 字段是否必选取决于交易介质、服务点输入方式和收单规范。本文件覆盖消费报文常用域，
       演示预置只填充当前场景需要的字段。
    9. DE52、DE55、DE64 的输入值均为连续 HEX；示例 PIN Block、IC 数据和 MAC 仅供测试。
-->
<iso8583>
    <!-- 报文基础：MTI 0200/0210 使用 2-byte 压缩 BCD。 -->
    <field position="0"  lengthEncode="BCD" lengthType="NONE" dataLength="4"   dataEncode="BCD" alignType="LEFT"  padding="0" desc="消息类型标识符（MTI）" />

    <!-- 持卡人与交易信息。 -->
    <field position="2"  lengthEncode="BCD" lengthType="PAIR" dataLength="19"  dataEncode="BCD" alignType="RIGHT" padding="0" desc="主账号（PAN）" />
    <field position="3"  lengthEncode="BCD" lengthType="NONE" dataLength="6"   dataEncode="BCD" alignType="RIGHT" padding="0" desc="交易处理码" />
    <field position="4"  lengthEncode="BCD" lengthType="NONE" dataLength="12"  dataEncode="BCD" alignType="RIGHT" padding="0" desc="交易金额（分）" />
    <field position="11" lengthEncode="BCD" lengthType="NONE" dataLength="6"   dataEncode="BCD" alignType="RIGHT" padding="0" desc="受卡方系统跟踪号（STAN）" />
    <field position="12" lengthEncode="BCD" lengthType="NONE" dataLength="6"   dataEncode="BCD" alignType="RIGHT" padding="0" desc="受卡方所在地时间（hhmmss）" />
    <field position="13" lengthEncode="BCD" lengthType="NONE" dataLength="4"   dataEncode="BCD" alignType="RIGHT" padding="0" desc="受卡方所在地日期（MMDD）" />
    <field position="14" lengthEncode="BCD" lengthType="NONE" dataLength="4"   dataEncode="BCD" alignType="RIGHT" padding="0" desc="卡有效期（YYMM）" />
    <field position="15" lengthEncode="BCD" lengthType="NONE" dataLength="4"   dataEncode="BCD" alignType="RIGHT" padding="0" desc="清算日期（MMDD）" />

    <!-- 受理环境与路由信息。N3 字段右对齐，高半字节补 0。 -->
    <field position="22" lengthEncode="BCD" lengthType="NONE" dataLength="3"   dataEncode="BCD" alignType="RIGHT" padding="0" desc="服务点输入方式码" />
    <field position="23" lengthEncode="BCD" lengthType="NONE" dataLength="3"   dataEncode="BCD" alignType="RIGHT" padding="0" desc="卡片序列号" />
    <field position="25" lengthEncode="BCD" lengthType="NONE" dataLength="2"   dataEncode="BCD" alignType="RIGHT" padding="0" desc="服务点条件码" />
    <field position="26" lengthEncode="BCD" lengthType="NONE" dataLength="2"   dataEncode="BCD" alignType="RIGHT" padding="0" desc="服务点 PIN 获取码" />
    <field position="32" lengthEncode="BCD" lengthType="PAIR" dataLength="11"  dataEncode="BCD" alignType="RIGHT" padding="0" desc="受理方标识码" />

    <!-- 磁道与中心响应信息。DE35 可使用十六进制 D 表示分隔符。 -->
    <field position="35" lengthEncode="BCD" lengthType="PAIR" dataLength="37"  dataEncode="BCD" alignType="LEFT"  padding="0" desc="二磁道数据" />
    <field position="36" lengthEncode="BCD" lengthType="TRIP" dataLength="104" dataEncode="BCD" alignType="LEFT"  padding="0" desc="三磁道数据" />
    <field position="37" lengthEncode="BCD" lengthType="NONE" dataLength="12"  dataEncode="ASC" alignType="LEFT"  padding=" " desc="检索参考号（RRN）" />
    <field position="38" lengthEncode="BCD" lengthType="NONE" dataLength="6"   dataEncode="ASC" alignType="LEFT"  padding=" " desc="授权码" />
    <field position="39" lengthEncode="BCD" lengthType="NONE" dataLength="2"   dataEncode="ASC" alignType="LEFT"  padding=" " desc="应答码" />

    <!-- 终端、商户及附加数据。 -->
    <field position="41" lengthEncode="BCD" lengthType="NONE" dataLength="8"   dataEncode="ASC" alignType="LEFT"  padding=" " desc="受卡机终端标识码" />
    <field position="42" lengthEncode="BCD" lengthType="NONE" dataLength="15"  dataEncode="ASC" alignType="LEFT"  padding=" " desc="受卡方标识码（商户号）" />
    <field position="44" lengthEncode="BCD" lengthType="PAIR" dataLength="25"  dataEncode="ASC" alignType="LEFT"  padding=" " desc="附加响应数据" />
    <field position="49" lengthEncode="BCD" lengthType="NONE" dataLength="3"   dataEncode="ASC" alignType="LEFT"  padding=" " desc="交易货币代码" />

    <!-- 安全与复合数据。BIT 域字符串输入必须是偶数位连续 HEX。 -->
    <field position="52" lengthEncode="BCD" lengthType="NONE" dataLength="8"   dataEncode="BIT" alignType="LEFT"  padding="0" desc="个人标识码数据（PIN Block）" />
    <field position="53" lengthEncode="BCD" lengthType="NONE" dataLength="16"  dataEncode="BCD" alignType="RIGHT" padding="0" desc="安全控制信息" />
    <field position="54" lengthEncode="BCD" lengthType="PAIR" dataLength="20"  dataEncode="ASC" alignType="LEFT"  padding=" " desc="附加金额" />
    <field position="55" lengthEncode="BCD" lengthType="TRIP" dataLength="255" dataEncode="BIT" alignType="LEFT"  padding="0" desc="IC 卡数据域（BER-TLV）" />
    <field position="64" lengthEncode="BCD" lengthType="NONE" dataLength="8"   dataEncode="BIT" alignType="LEFT"  padding="0" desc="报文鉴别码（MAC）" />
</iso8583>
