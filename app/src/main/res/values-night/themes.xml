<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 调试工具保持同一高对比度配色，避免夜间模式改变 HEX 与状态色含义。 -->
    <style name="Theme.LightEncode" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/navy</item>
        <item name="colorAccent">@color/primary</item>
        <item name="android:navigationBarColor">@color/navy</item>
        <item name="android:statusBarColor">@color/navy</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">@color/page_background</item>
    </style>
</resources>
